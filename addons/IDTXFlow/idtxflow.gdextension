[configuration]

entry_symbol = "idtxflow_library_init"
compatibility_minimum = "4.5"

[libraries]
; Relative paths ensure that our GDExtension can be placed anywhere in the project directory.
windows.arm64.debug = "./bin/windows/arm64/idtxflow.windows.template_debug.arm64.dll"
windows.arm64.release = "./bin/windows/arm64/idtxflow.windows.template_release.arm64.dll"

windows.x86_64.debug = "./bin/windows/x86_64/idtxflow.windows.template_debug.x86_64.dll"
windows.x86_64.release = "./bin/windows/x86_64/idtxflow.windows.template_release.x86_64.dll"

macos.arm64.debug = "./bin/macos/arm64/libidtxflow.macos.template_debug.arm64.dylib"
macos.arm64.release = "./bin/macos/arm64/libidtxflow.macos.template_release.arm64.dylib"
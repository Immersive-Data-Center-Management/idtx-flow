# Copy to `.env` and fill in real values. `.env` is gitignored — do NOT commit secrets.
# The harness reads these if the matching CLI flags are not provided.

# Backend base URL (http or https). Default if unset: http://localhost:8080
IDTX_BASE_URL=http://localhost:8080

# ROPC login credentials for POST /api/v1/auth/login
IDTX_USER=your-username
IDTX_PASSWORD=your-password
#usda 1.0
#openUSD extension schema to introduce specific (HasAPI and IsA) schemas 
(
    subLayers = [
        @usdGeom/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName       = "IDTX"
        string libraryPath       = "."
    }
)
{
}

class Compute_ValueFromJson "Compute_ValueFromJson" (
    inherits = </Typed>
    customData = {
        string userDocBrief = "This Schema (PrimType) registers a computation that will extract a field value from a JSON string."
    }
)
{
    string inputs:jsonData = "{}" (
        customData = {
            string userDocBrief = "The Json input data, the value shall be extracted from. If this is not valid json there will be no value extracted."
        }
    )
    string jsonPath (
        customData = {
            string userDocBrief = "The path to the field within the json data the value shall be extracted from."
        }
    )
    token jsonValueType (
		allowedTokens = ["none", "float", "double", "string"]
		customData = {
			string userDocBrief = "The value type should match the actual data type that shall be extracted from the json path."
		}
	)
    double outputs:jsonValue:double (
        customData = {
            string userDocBrief = "used as output, when the valueType = double."
        }
    )
    float outputs:jsonValue:float (
        customData = {
            string userDocBrief = "used as output, when the valueType = float."
        }
    )
    string outputs:jsonValue:string (
        customData = {
            string userDocBrief = "used as output, when the valueType = string."
        }
    )    
}

class Compute_Environment "Compute_Environment" (
    inherits = </Typed>
    customData = {
        string userDocBrief = "This Schema (PrimType) registers a computation that resolves an input key string into a value string using a host-registered provider (e.g. environment variables or engine project settings). The USD library itself does not know how the value is produced; the host application registers a provider implementation."
    }
)
{
    string inputs:key = "" (
        customData = {
            string userDocBrief = "The key to resolve. A prefix selects the provider domain, e.g. 'env:PATH' resolves the environment variable PATH, 'project:physics/gravity' resolves an engine project setting. Keys without a known prefix are routed to the default provider if one is registered."
        }
    )
    string outputs:value = "" (
        customData = {
            string userDocBrief = "The resolved value string. Empty if the key could not be resolved or no matching provider was registered."
        }
    )
}

class Compute_VarReplacements "Compute_VarReplacements" (
    inherits = </Typed>
    customData = {
        string userDocBrief = "This Schema (PrimType) registers a computation that replaces every token of the form ${<type>:<name>} inside the input string with a value resolved via a host-registered provider (e.g. env, auth, var). The USD library itself does not know how the values are produced; the host application registers provider implementations. The 'type' selects the provider domain and the 'name' is the key passed to that provider."
    }
)
{
    string inputs:template = "" (
        customData = {
            string userDocBrief = "The input string that may contain tokens of the form ${<type>:<name>}, e.g. 'ts=${var:CURRENT_TIME}&home=${env:HOME}'. Each token is replaced with the value resolved by the provider registered for <type>. Tokens that cannot be resolved are replaced with an empty string."
        }
    )
    string outputs:result = "" (
        customData = {
            string userDocBrief = "The input string with every ${<type>:<name>} token replaced by its resolved value."
        }
    )
}

class Compute_ScaleDouble "Compute_ScaleDouble" (
    inherits = </Typed>
    customData = {
        string userDocBrief = "This Schema (PrimType) registers a computation that will multiply the input value with the scalarFactor"
    }
)
{
    double scalarFactor = 1.0 (
        doc = """The scalar factor that shall be multiplied to the input value"""
    )
    double inputs:value = 0.0 (
        doc = """The input value to this computation. Could be connected to another compute node"""
    )
    double outputs:result (
        doc = """The result of the computation"""
    )
}

class "Datasource" (
    inherits = </Typed>
    doc = """Base class for all data source primitives."""
) {
    string outputs:data = "{}" (
            doc = """ The data output of the data source as JSON string """
        )
}

class MockDatasource_RandomFloat "MockDatasource_RandomFloat" (
    inherits = </Datasource>
    doc = """This is an example mock data source that produces random float values.\nThe float values are provided as a simple Json structure like:\n\\code\n{\n data: { value: 0.123 }\n}\n\\endcode\n
    """
) {
    float interval = 1.0 (
        doc = """The update interval in seconds the mock datasource shall provide data and author the \\sa outputs:data attribute in the current usd stage this prim is authored. """
    )
}

class RestDatasource "RestDatasource" (
    inherits = </Datasource>
    doc = """This is a REST data source that calls the provided REST endoint and returns the JSON response.\n
    """
) {
    string endpoint = "" (
        doc = """The base URL of the REST API endpoint"""
    )

    string query = "" (
            doc = """The query to append to the endpoint URL after the path. Value is url encoded"""
        )

    token method = "GET" (
        allowedTokens = ["GET", "POST"]
        doc = """HTTP Method to be used for the call to the endpoint. Allowed: GET, POST"""
    )

    string authorization (
        doc = """The authorization header value passed to the request. Usually 'Bearer <TOKEN>'"""
    )

    string jsonBody = "{}" (
        doc = """The JSON body to be send to the endpoint, when the method is set to POST"""
    )

    float interval = 1.0 (
        doc = """The update interval in seconds the REST datasource shall call it's endpoint and author the response into \\sa outputs:data attribute in the current usd stage this prim is authored. """
    )
}


class "CollisionAPI" (
	doc = "Collision-related metadata attachable to geometry prims"
    inherits = </APISchemaBase>
    customData = {
        string apiSchemaType = "singleApply"
        token[] apiSchemaCanOnlyApplyTo = ["Cube", 
										   "Sphere", 
										   "Cylinder",
										   "Capsule"]
    }
)
{
	token collision:shape = "Box" (
		allowedTokens = ["Box", "Sphere", "Capsule", "Cylinder", "Convex"]
		doc = "Collision shape override"
	)
	
	token collision:type = "Static" (
		allowedTokens = ["Static", "Rigidbody"]
		doc = "Collision behavior type"
	)
	
	token[] collision:interactionTypes = ["Collide"] (
		allowedTokens = ["Collide", "Select", "Grab"]
		doc = "How colliders participate in interaction."
	)
	
	token purpose = "guide" (
		customData = {
                bool apiSchemaOverride = true
            }
	)
	
	token visibility = "invisible" (
		customData = {
                bool apiSchemaOverride = true
            }
	)	
}

class "InteractionAPI" (
	doc = "Interaction-related metadata attachable to prims."
    inherits = </APISchemaBase>
    customData = {
        string apiSchemaType = "singleApply"
    }
)
{
	
	bool interaction:enabled = true (
		doc = "Define if colliders participate in interaction."
	)
	
	bool interaction:highlightable = true (
		doc = "Define if the asset shall display a highlight effect when selected. Actual implementation needs to be done on the engine side."
	)
	
	color3f interaction:highlightColor = (1.0, 0.0, 0.0) (
		doc = "Color for the highlight effect."
	)
	
	uniform token interaction:identifier = "NO_VALUE" (
		doc = "Used to link the asset to a specific interaction behavior in the engine. E.g. passing to the implemented interaction handler methods."
	)
	
}

class "CollisionSetAPI" (
	doc = "The collision set contains a list of relationships to the actual colliders."
    inherits = </APISchemaBase>
    customData = {
        string apiSchemaType = "singleApply"
    }
)
{
	rel physics:collider (
		doc = "Define which prims are used as colliders."
		)
    
    rel physics:collider:querry (
		doc = "If the collider used for interaction raycasting is different from the ones used for physics simulation, this should be authored here. Entries in this list overrule the entries in the physics:collider list for interaction queries."
	)
	
}

